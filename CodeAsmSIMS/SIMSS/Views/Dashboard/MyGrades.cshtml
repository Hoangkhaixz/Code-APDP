@using SIMSS.Models
@model List<StudentGradesViewModel>

@{
    ViewData["Title"] = "Điểm của tôi";
    ViewData["breadcrumb"] = "Dashboard";
    ViewData["breadcrumb-item"] = "Điểm của tôi";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<h1 class="mt-4">Điểm của tôi</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Dashboard</a></li>
    <li class="breadcrumb-item active">Điểm của tôi</li>
</ol>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-graduation-cap me-1"></i>
        Bảng điểm của bạn
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Mã khóa học</th>
                            <th>Tên khóa học</th>
                            <th>Ngày đăng ký</th>
                            <th>Lớp</th>
                            <th>Điểm</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CourseCode</td>
                                <td>@item.CourseName</td>
                                <td>@item.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                                <td>@(item.Class ?? "N/A")</td>
                                <td>@(item.Grade ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>Bạn chưa có điểm nào.</p>
        }
    </div>
</div>
