@model SIMSS.SimsDbContext.Entities.Faculty
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Edit Faculty";
    ViewData["breadcrumb"] = "Edit Faculty";
    ViewData["breadcrumb-item"] = "Edit existing Faculty";
}
<h2>Edit Faculty</h2>


<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="FacultyID" />
    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Department" class="form-label"></label>
        <input asp-for="Department" class="form-control" placeholder="e.g., Computer Science, Mathematics" />
        <span asp-validation-for="Department" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UserID" class="form-label">User Account</label>
        <select asp-for="UserID" class="form-select" asp-items="@(new SelectList(ViewBag.Users as System.Collections.IEnumerable, "UserID", "Username"))">
            <option value="">-- Select User Account --</option>
        </select>
        <span asp-validation-for="UserID" class="text-danger"></span>
        <small class="form-text text-muted">Select a user account that has Faculty role</small>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml");}
}
