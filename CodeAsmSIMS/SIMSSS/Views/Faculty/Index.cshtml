@model IEnumerable<SIMSS.SimsDbContext.Entities.Faculty>
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Faculty Page";
    ViewData["breadcrumb"] = "Faculty";
    ViewData["breadcrumb-item"] = "List of Faculty";
}
<h2>List of Faculty</h2>
<!-- Thông báo chỉ hiện khi TempData có giá trị -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (User.IsInRole("Admin"))
{
    <a asp-action="Add" class="btn btn-success mb-3">Add New Faculty</a>
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Department</th>
            <th>UserID</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Department</td>
                <td>@item.UserID</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.FacultyID" class="btn btn-primary btn-sm">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.FacultyID" method="post" style="display:inline-block" onsubmit="return confirm('Do you really want to delete this faculty?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                }
            </tr>
        }
    } else {
        <tr><td colspan="5" class="text-center">No faculty found.</td></tr>
    }
    </tbody>
</table>
