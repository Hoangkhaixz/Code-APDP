@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using Microsoft.AspNetCore.Authorization
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["breadcrumb"] = "Dashboard";
    ViewData["breadcrumb-item"] = "Overview";
}
@if (User.IsInRole("Admin"))
{
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Total Students</div>
                            <div class="h4 mb-0">@ViewBag.TotalStudents</div>
                        </div>
                        <div><i class="fas fa-user-graduate fa-2x"></i></div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-controller="Student" asp-action="Index">View Details</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Total Courses</div>
                            <div class="h4 mb-0">@ViewBag.TotalCourses</div>
                        </div>
                        <div><i class="fas fa-book fa-2x"></i></div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-controller="Course" asp-action="Index">View Details</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Total Faculty</div>
                            <div class="h4 mb-0">@ViewBag.TotalFaculties</div>
                        </div>
                        <div><i class="fas fa-chalkboard-teacher fa-2x"></i></div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-controller="Faculty" asp-action="Index">View Details</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-bolt mr-1"></i>
                    Quick Actions
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Student" asp-action="Add" class="btn btn-success btn-lg w-100">
                                <i class="fas fa-user-plus"></i> Add New Student
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Course" asp-action="Add" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-plus-circle"></i> Add New Course
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Faculty" asp-action="Add" class="btn btn-warning btn-lg w-100">
                                <i class="fas fa-user-tie"></i> Add New Faculty
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Biểu đồ nằm cạnh nhau -->
    <div class="row">
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-1"></i> Số lượng sinh viên theo Khoa
                </div>
                <div class="card-body">
                    <canvas id="facultyStudentChart" width="100%" height="40"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-1"></i> Số sinh viên đăng ký từng môn
                </div>
                <div class="card-body">
                    <canvas id="courseEnrollmentChart" width="100%" height="40"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart 1: Số lượng sinh viên theo khoa
        fetch('/Dashboard/StudentsByFaculty')
            .then(res => res.json())
            .then(data => {
                const ctx = document.getElementById('facultyStudentChart');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: data.map(x => x.department),
                        datasets: [{
                            label: 'Số lượng sinh viên',
                            data: data.map(x => x.studentCount),
                            backgroundColor: 'rgba(54,162,235,0.7)'
                        }]
                    },
                    options: {
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            });

        // Chart 2: Số sinh viên đăng ký từng môn học
        fetch('/Dashboard/EnrollmentsByCourse')
            .then(res => res.json())
            .then(data => {
                const ctx = document.getElementById('courseEnrollmentChart');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: data.map(x => x.courseName),
                        datasets: [{
                            label: 'Đăng ký',
                            data: data.map(x => x.enrollmentCount),
                            backgroundColor: 'rgba(153,102,255,0.7)'
                        }]
                    },
                    options: {
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            });
    </script>
}
else if (User.IsInRole("Faculty"))
{
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Total Enrollments</div>
                            <div class="h4 mb-0">@ViewBag.TotalEnrollments</div>
                        </div>
                        <div><i class="fas fa-clipboard-list fa-2x"></i></div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-controller="Enrollment" asp-action="Index">View Details</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-bolt mr-1"></i>
                    Quick Actions
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Enrollment" asp-action="Add" class="btn btn-info btn-lg w-100">
                                <i class="fas fa-user-check"></i> New Enrollment
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col col-sm-12 col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h3>Welcome to Student Information Management System</h3>
                </div>
                <div class="card-body">
                    <p>This is your dashboard. Use the sidebar to navigate to different sections.</p>
                    <div class="mt-4">
                        <a asp-controller="Dashboard" asp-action="MyGrades" class="btn btn-info me-2">
                            <i class="fas fa-poll"></i> View My Grades
                        </a>
                        <a asp-controller="Dashboard" asp-action="EditProfile" class="btn btn-warning me-2">
                            <i class="fas fa-user-edit"></i> Edit Profile
                        </a>
                        <a asp-controller="Student" asp-action="Index" class="btn btn-primary me-2">
                            <i class="fas fa-users"></i> View Students
                        </a>
                        <a asp-controller="Course" asp-action="Index" class="btn btn-success">
                            <i class="fas fa-book"></i> View Courses
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
